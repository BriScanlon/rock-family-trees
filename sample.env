# Copy to .env (optional — these are the defaults docker-compose uses).

BACKEND_PORT=8000
FRONTEND_PORT=3000

# "celery" = jobs run on the RabbitMQ worker; "inline" = jobs run inside the API process
TASK_MODE=celery
RABBITMQ_URL=pyamqp://guest:guest@rftg-rabbitmq//

# "neo4j" or "file" (JSON cache on disk). Falls back to "file" if Neo4j is unreachable.
GRAPH_STORE=neo4j
NEO4J_URI=bolt://rftg-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# MusicBrainz asks every client to identify itself with contact details
MB_USER_AGENT=RockFamilyTreeGen/2.0 ( you@example.com )

# The notes written from Wikipedia: a local model through Ollama (default), or Claude
NARRATIVE_BACKEND=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=rftg-qwen3   # build it: ollama create rftg-qwen3 -f ollama/Modelfile
# only for NARRATIVE_BACKEND=anthropic
ANTHROPIC_API_KEY=
